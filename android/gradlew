#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VERSION="8.9"
EXPECTED_SHA256="d725d707bfabd4dfdc958c624003b3c80accc03f7037b5122c4b1d0ef15cecab"
DIST_ROOT="$SCRIPT_DIR/.gradle-dist"
DIST_DIR="$DIST_ROOT/gradle-$VERSION"
ZIP="$DIST_ROOT/gradle-$VERSION-bin.zip"
URL="https://services.gradle.org/distributions/gradle-$VERSION-bin.zip"

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    echo "Neither sha256sum nor shasum is available; cannot verify Gradle download." >&2
    exit 1
  fi
}

verify_zip() {
  local actual
  actual="$(sha256_file "$ZIP")"
  if [ "$actual" != "$EXPECTED_SHA256" ]; then
    echo "Gradle distribution checksum mismatch." >&2
    echo "Expected: $EXPECTED_SHA256" >&2
    echo "Actual:   $actual" >&2
    rm -f "$ZIP"
    exit 1
  fi
}

if [ ! -x "$DIST_DIR/bin/gradle" ]; then
  mkdir -p "$DIST_ROOT"
  if [ ! -f "$ZIP" ]; then
    echo "Downloading Gradle $VERSION..."
    curl --fail --location --proto '=https' --proto-redir '=https' --tlsv1.2 "$URL" -o "$ZIP"
  fi
  verify_zip
  rm -rf "$DIST_DIR"
  unzip -q "$ZIP" -d "$DIST_ROOT"
fi

exec "$DIST_DIR/bin/gradle" "$@"
