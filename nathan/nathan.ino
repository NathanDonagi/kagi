};

static inline uint32_t ror32(uint32_t x, uint8_t n) { return (x >> n) | (x << (32 - n)); }

// 16-word rolling message schedule: 64 bytes of RAM instead of 256.
static void sha256_compress(uint32_t h[8], const uint8_t block[64]) {
  uint32_t w[16];
  for (uint8_t i = 0; i < 16; i++)
    w[i] = (uint32_t)block[4 * i] << 24 | (uint32_t)block[4 * i + 1] << 16 |
           (uint32_t)block[4 * i + 2] << 8 | block[4 * i + 3];
  uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7];
  for (uint8_t i = 0; i < 64; i++) {
    uint32_t wi;
    if (i < 16) {
      wi = w[i];
    } else {
      uint32_t w15 = w[(i + 1) & 15], w2 = w[(i + 14) & 15];
      uint32_t s0 = ror32(w15, 7) ^ ror32(w15, 18) ^ (w15 >> 3);
      uint32_t s1 = ror32(w2, 17) ^ ror32(w2, 19) ^ (w2 >> 10);
      wi = w[i & 15] += s0 + w[(i + 9) & 15] + s1;
    }
    uint32_t t1 = hh + (ror32(e, 6) ^ ror32(e, 11) ^ ror32(e, 25)) + ((e & f) ^ (~e & g)) +
                  pgm_read_dword(&SHA_K[i]) + wi;
    uint32_t t2 = (ror32(a, 2) ^ ror32(a, 13) ^ ror32(a, 22)) + ((a & b) ^ (a & c) ^ (b & c));
    hh = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
  }
  h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
}

static void sha256_init(Sha256 *c) {
  for (uint8_t i = 0; i < 8; i++) c->h[i] = pgm_read_dword(&SHA_H0[i]);
  c->buflen = 0;
  c->total = 0;
}

static void sha256_update(Sha256 *c, const void *data, uint16_t len) {
  const uint8_t *p = (const uint8_t *)data;
  c->total += len;
  while (len--) {
    c->buf[c->buflen++] = *p++;
    if (c->buflen == 64) {
      sha256_compress(c->h, c->buf);
      c->buflen = 0;
    }
  }
}

static void sha256_str(Sha256 *c, const char *s) { sha256_update(c, s, strlen(s)); }

static void sha256_final(Sha256 *c, uint8_t out[32]) {
  uint32_t bits = c->total << 3;   // messages here are tiny
  uint8_t pad = 0x80;
  sha256_update(c, &pad, 1);
  pad = 0;
  while (c->buflen != 56) sha256_update(c, &pad, 1);
  uint8_t len[8] = {0, 0, 0, 0, (uint8_t)(bits >> 24), (uint8_t)(bits >> 16),
                    (uint8_t)(bits >> 8), (uint8_t)bits};
  sha256_update(c, len, 8);
  for (uint8_t i = 0; i < 8; i++) {
    out[4 * i] = c->h[i] >> 24;
    out[4 * i + 1] = c->h[i] >> 16;
    out[4 * i + 2] = c->h[i] >> 8;
    out[4 * i + 3] = c->h[i];
  }
}

// State after hashing one 64-byte block of (32-byte key) ^ pad.
static void sha256_keyed(Sha256 *c, const uint8_t key[32], uint8_t pad) {
  uint8_t block[64];
  for (uint8_t i = 0; i < 64; i++) block[i] = (i < 32 ? key[i] : 0) ^ pad;
  sha256_init(c);
  sha256_update(c, block, 64);
}

// HMAC-SHA256 with a 32-byte key, split so the keyed states can be reused.
static void hmac_begin(Sha256 *inner, uint32_t outer[8], const uint8_t key[32]) {
  sha256_keyed(inner, key, 0x5c);
  memcpy(outer, inner->h, 32);
  sha256_keyed(inner, key, 0x36);
}

static void hmac_end(Sha256 *inner, const uint32_t outer[8], uint8_t out[32]) {
  uint8_t ih[32];
  sha256_final(inner, ih);
  memcpy(inner->h, outer, 32);
  inner->buflen = 0;
  inner->total = 64;
  sha256_update(inner, ih, 32);
  sha256_final(inner, out);
}

// Same as Python: hashlib.pbkdf2_hmac("sha256", pwd, salt, iters, 32)
static void pbkdf2_sha256(const uint8_t pwd[32], const uint8_t salt[32], uint16_t iters,
                          uint8_t out[32]) {
  static const uint8_t one[4] = {0, 0, 0, 1};
  Sha256 base, c;
  uint32_t outer[8];
  uint8_t u[32];
  hmac_begin(&base, outer, pwd);
  c = base;
  sha256_update(&c, salt, 32);
  sha256_update(&c, one, 4);
  hmac_end(&c, outer, u);
  memcpy(out, u, 32);
  for (uint16_t i = 1; i < iters; i++) {
    c = base;
    sha256_update(&c, u, 32);
    hmac_end(&c, outer, u);
    for (uint8_t j = 0; j < 32; j++) out[j] ^= u[j];
  }
}

// ---------- normalization (ASCII version of kagi.normalize) ----------

// Lowercase, trim, collapse runs of whitespace. Rejects characters that would
// need JSON escaping or aren't plain ASCII, so the JSON below stays trivial.
static bool norm_name(const char *in, char *out) {
  uint8_t n = 0;
  bool space = false;
  for (; *in; in++) {
    char ch = *in;
    if (ch == ' ' || ch == '\t') {
      space = n > 0;
      continue;
    }
    if (ch < 0x21 || ch > 0x7e || ch == '"' || ch == '\\') return false;
    if (space) {
      if (n >= MAX_NAME) return false;
      out[n++] = ' ';
      space = false;
    }
    if (n >= MAX_NAME) return false;
    out[n++] = (ch >= 'A' && ch <= 'Z') ? ch + 32 : ch;
  }
  out[n] = 0;
  return n > 0;
}

// Keeps only digits, dropping spaces (and dashes if allowed). Needs exactly `want` digits.
static bool norm_digits(const char *in, char *out, uint8_t want, bool allow_dash) {
  uint8_t n = 0;
  for (; *in; in++) {
    if (*in == ' ' || *in == '\t' || (allow_dash && *in == '-')) continue;
    if (*in < '0' || *in > '9' || n >= want) return false;
    out[n++] = *in;
  }
  out[n] = 0;
  return n == want;
}

static bool leap(uint16_t y) { return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0; }

// Accepts YYYY-MM-DD, YYYY/MM/DD, MM/DD/YYYY, MM-DD-YYYY (one-digit month/day ok).
// Output: YYYY-MM-DD.
static bool norm_dob(const char *in, char *out) {
  uint16_t part[3] = {0, 0, 0};
  uint8_t digits[3] = {0, 0, 0}, k = 0;
  while (*in == ' ') in++;
  for (; *in && *in != ' '; in++) {
    if (*in == '-' || *in == '/') {
      if (++k > 2) return false;
    } else if (*in >= '0' && *in <= '9') {
      if (++digits[k] > 4) return false;
      part[k] = part[k] * 10 + (*in - '0');
    } else {
      return false;
    }
  }
  while (*in == ' ') in++;
  if (*in || k != 2) return false;
  uint16_t y, m, d;
  if (digits[0] == 4 && digits[1] <= 2 && digits[2] <= 2) {
    y = part[0]; m = part[1]; d = part[2];
  } else if (digits[2] == 4 && digits[0] <= 2 && digits[1] <= 2) {
    m = part[0]; d = part[1]; y = part[2];
  } else {
    return false;
  }
  static const uint8_t mdays[12] = {31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
  if (!digits[1] || !digits[2] || !digits[0]) return false;
  if (y < 1000 || m < 1 || m > 12 || d < 1 || d > mdays[m - 1]) return false;
  if (m == 2 && d == 29 && !leap(y)) return false;
  out[0] = '0' + y / 1000; out[1] = '0' + y / 100 % 10; out[2] = '0' + y / 10 % 10;
  out[3] = '0' + y % 10; out[4] = '-';
  out[5] = '0' + m / 10; out[6] = '0' + m % 10; out[7] = '-';
  out[8] = '0' + d / 10; out[9] = '0' + d % 10; out[10] = 0;
  return true;
}

// ---------- query parsing ----------

// "k=v;k=v;..." -> Query. Unknown, repeated or malformed fields reject the query.
static bool parse_query(char *s, Query *q) {
  memset(q, 0, sizeof *q);
  while (*s) {
    char *end = strchr(s, ';');
    if (end) *end = 0;
    char *eq = strchr(s, '=');
    if (!eq) return false;
    *eq = 0;
    char *key = s, *val = eq + 1;
    while (*key == ' ') key++;
    for (char *t = eq - 1; t >= key && *t == ' '; t--) *t = 0;

    uint8_t bit;
    bool ok;
    if (!strcmp(key, "first_name")) {
      bit = F_FIRST; ok = norm_name(val, q->first);
    } else if (!strcmp(key, "last_name")) {
      bit = F_LAST; ok = norm_name(val, q->last);
    } else if (!strcmp(key, "dob")) {
      bit = F_DOB; ok = norm_dob(val, q->dob);
    } else if (!strcmp(key, "ssn")) {
      bit = F_SSN; ok = norm_digits(val, q->ssn, 9, true);
    } else if (!strcmp(key, "pin")) {
      bit = F_PIN; ok = norm_digits(val, q->pin, 4, false);
    } else if (!strcmp(key, "over")) {
      char t[3];
      bit = F_OVER;
      ok = norm_digits(val, t, 2, false);
      q->over = ok ? (t[0] - '0') * 10 + (t[1] - '0') : 0;
      ok = ok && (q->over == 18 || q->over == 21);
    } else {
      return false;
    }
    if (!ok || (q->has & bit)) return false;
    q->has |= bit;
    if (!end) break;
    s = end + 1;
  }
  return true;
}

// ---------- commitments ----------

static void put_str(Sha256 *c, const char *s) {
  sha256_str(c, "\"");
  sha256_str(c, s);
  sha256_str(c, "\"");
}

static void put_name(Sha256 *c, const Query *q) {
  sha256_str(c, "[");
  put_str(c, q->first);
  sha256_str(c, ",");
  put_str(c, q->last);
  sha256_str(c, "]");
}

// Constant-time: the whole buffer is always compared.
static bool same32(const uint8_t *a, const uint8_t *b) {
  uint8_t diff = 0;
  for (uint8_t i = 0; i < 32; i++) diff |= a[i] ^ b[i];
  return diff == 0;
}

// Which commitment a query is checked against, and the scope it proves.
// Returns NULL for queries that break the rules (these don't count as guesses).
static const uint8_t *pick_commitment(const Query *q, const char **scope) {
  uint8_t has = q->has;
  if (has & F_OVER) {
    if (has != F_OVER) return NULL;                        // over stands alone
    *scope = q->over == 18 ? "OVER18" : "OVER21";
    return q->over == 18 ? BK_C_OVER18 : BK_C_OVER21;
  }
  if (!(has & F_FIRST) || !(has & F_LAST)) return NULL;   // name always needed, both halves
  if (has & F_SSN) {
    if (has != (F_FIRST | F_LAST | F_DOB | F_SSN | F_PIN)) return NULL;
    *scope = "L2";
    return BK_C_SSN;
  }
  if (has & F_PIN) return NULL;                            // a pin alone is meaningless
  *scope = "L1";
  return (has & F_DOB) ? BK_C_DOB : BK_C_FULL_NAME;
}

// One PBKDF2 per query. The L2 commitment covers every level-1 value, and the
// dob commitment covers the name, so checking the single most specific
// commitment gives the same answer as checking each level in turn.
static bool check_query(const Query *q, const uint8_t *commitment) {
  Sha256 c;
  sha256_init(&c);
  if (commitment == BK_C_OVER18 || commitment == BK_C_OVER21) {
    sha256_str(&c, q->over == 18 ? "[\"OVER\",18" : "[\"OVER\",21");
  } else if (commitment == BK_C_SSN) {
    sha256_str(&c, "[\"L2\",\"ssn\",");
    put_name(&c, q);
    sha256_str(&c, ",");
    put_str(&c, q->dob);
    sha256_str(&c, ",");
    put_str(&c, q->pin);
    sha256_str(&c, ",");
    put_str(&c, q->ssn);
  } else if (commitment == BK_C_DOB) {
    sha256_str(&c, "[\"L1\",\"dob\",");
    put_name(&c, q);
    sha256_str(&c, ",");
    put_str(&c, q->dob);
  } else {
    sha256_str(&c, "[\"L1\",\"full_name\",");
    put_name(&c, q);
  }
  sha256_str(&c, "]");

  uint8_t pwd[32], salt[32], want[32], got[32];
  sha256_final(&c, pwd);
  memcpy_P(salt, commitment, 32);
  memcpy_P(want, commitment + 32, 32);
  pbkdf2_sha256(pwd, salt, BK_KDF_ITERS, got);
  return same32(got, want);
}

// ---------- serial output ----------

static void print_hex(const uint8_t *b, uint8_t n, bool progmem) {
  static const char digits[] = "0123456789abcdef";
  for (uint8_t i = 0; i < n; i++) {
    uint8_t v = progmem ? pgm_read_byte(b + i) : b[i];
    Serial.write(digits[v >> 4]);
    Serial.write(digits[v & 15]);
  }
}

// Prints HMAC(device_secret, "<tag>|<key id hex>|<a>|<b>") as hex.
static void print_mac(const char *tag, const char *a, const char *b) {
  static const char digits[] = "0123456789abcdef";
  uint8_t secret[32], mac[32];
  uint32_t outer[8];
  Sha256 c;
  memcpy_P(secret, BK_DEVICE_SECRET, 32);
  hmac_begin(&c, outer, secret);
  memset(secret, 0, 32);
  sha256_str(&c, tag);
  sha256_str(&c, "|");
  for (uint8_t i = 0; i < 12; i++) {
    uint8_t v = pgm_read_byte(BK_KEY_ID + i);
    char hx[2] = {digits[v >> 4], digits[v & 15]};
    sha256_update(&c, hx, 2);
  }
  sha256_str(&c, "|");
  sha256_str(&c, a);
  sha256_str(&c, "|");
  sha256_str(&c, b);
  hmac_end(&c, outer, mac);
  print_hex(mac, 32, false);
}

// proof = HMAC(device_secret, "kagi-nano-v1|<key id hex>|<scope>|<challenge>")
static void send_proof(const char *scope, const char *challenge) {
  Serial.print(F("AUTHENTICATED "));
  Serial.print(scope);
  Serial.print(' ');
  print_mac("kagi-nano-v1", scope, challenge);
  Serial.println();
}

// ---------- lockout ----------

static uint8_t get_fails() { return EEPROM.read(EE_FAILS); }
static void set_fails(uint8_t n) { EEPROM.update(EE_FAILS, n); }

static unsigned long cooldown_ms(uint8_t fails) {
  if (fails < FREE_TRIES) return 0;
  uint8_t shift = fails - FREE_TRIES;
  if (shift > 8) shift = 8;
  return (15000UL) << shift;
}

// ---------- commands ----------

static bool valid_challenge(const char *s) {
  if (!strcmp(s, "-")) return true;
  uint8_t n = 0;
  for (; *s; s++, n++) {
    bool hex = (*s >= '0' && *s <= '9') || (*s >= 'a' && *s <= 'f');
    if (!hex || n >= 64) return false;
  }
  return n > 0;
}

static void cmd_auth(char *args) {
  // args = "<challenge> <query>"
  while (*args == ' ') args++;
  char *sp = strchr(args, ' ');
  if (!sp) {
    Serial.println(F("ERR usage: AUTH <challenge> first_name=..;last_name=..;..."));
    return;
  }
  *sp = 0;
  char *challenge = args;
  if (!valid_challenge(challenge)) {
    Serial.println(F("ERR challenge must be 1-64 lowercase hex chars, or -"));
    return;
  }

  Query q;
  const char *scope = NULL;
  const uint8_t *commitment = NULL;
  if (parse_query(sp + 1, &q)) commitment = pick_commitment(&q, &scope);
  if (!commitment) {
    Serial.println(F("DENIED"));   // like kagi.py: no hint about what was wrong
    return;
  }

  // Over queries have no secret input, so they aren't guesses: no lockout, no count.
  bool guess = strncmp(scope, "OVER", 4) != 0;
  uint8_t fails = get_fails();
  if (guess) {
    unsigned long wait = cooldown_ms(fails), since = millis() - last_attempt;
    if (since < wait) {
      Serial.print(F("LOCKED "));
      Serial.println((wait - since + 999) / 1000);
      return;
    }
    // Count the attempt as a failure BEFORE checking, so pulling the power
    // mid-check can't be used to dodge the counter.
    last_attempt = millis();
    set_fails(fails < 255 ? fails + 1 : 255);
  }
  Serial.println(F("WORKING"));

  if (check_query(&q, commitment)) {
    if (guess) set_fails(!strcmp(scope, "L2") ? 0 : fails);
    send_proof(scope, challenge);
  } else {
    Serial.println(F("DENIED"));
  }
  memset(&q, 0, sizeof q);
}

static bool valid_site(const char *s) {
  uint8_t n = 0;
  for (; *s; s++, n++) {
    bool ok = (*s >= 'a' && *s <= 'z') || (*s >= '0' && *s <= '9') || *s == '.' || *s == '-';
    if (!ok || n >= 64) return false;
  }
  return n > 0;
}

static bool wait_for_tap() {
#if USE_TAP_BUTTON
  Serial.println(F("TAP"));
  unsigned long start = millis();
  while (millis() - start < TAP_TIMEOUT_MS) {
    digitalWrite(LED_BUILTIN, (millis() / 150) & 1);
    if (digitalRead(TAP_PIN) == LOW) {
      delay(30);                                   // debounce
      if (digitalRead(TAP_PIN) == LOW) {
        digitalWrite(LED_BUILTIN, LOW);
        while (digitalRead(TAP_PIN) == LOW) {}     // wait for release
        return true;
      }
    }
  }
  digitalWrite(LED_BUILTIN, LOW);
  return false;
#else
  return true;
#endif
}

// SIGN <nonce> <site_id>: the key's answer to a unique sign-up challenge.
// proof = HMAC(device_secret, "kagi-nano-sign-v1|<key id hex>|<site_id>|<nonce>")
// It reveals nothing about the person; the central server maps the key id to
// an opaque person id it got from the authority at provisioning.
static void cmd_sign(char *args) {
  while (*args == ' ') args++;
  char *sp = strchr(args, ' ');
  if (!sp) {
    Serial.println(F("ERR usage: SIGN <nonce hex> <site_id>"));
    return;
  }
  *sp = 0;
  char *nonce = args, *site = sp + 1;
  while (*site == ' ') site++;
  if (!strcmp(nonce, "-") || !valid_challenge(nonce) || !valid_site(site)) {
    Serial.println(F("ERR nonce must be 1-64 lowercase hex chars, site_id [a-z0-9.-]"));
    return;
  }
  if (!wait_for_tap()) {
    Serial.println(F("TIMEOUT"));
    return;
  }
  Serial.print(F("SIGNED "));
  print_mac("kagi-nano-sign-v1", site, nonce);
  Serial.println();
}

static void handle_line(char *s) {
  while (*s == ' ') s++;
  if (!strcmp(s, "PING")) {
    Serial.println(F("PONG kagi-nano v1"));
  } else if (!strcmp(s, "INFO")) {
    Serial.print(F("INFO id="));
    print_hex(BK_KEY_ID, 12, true);
    Serial.print(F(" iters="));
    Serial.print(BK_KDF_ITERS);
    Serial.print(F(" fails="));
    Serial.print(get_fails());
    Serial.print(F(" tap="));
    Serial.println(USE_TAP_BUTTON);
  } else if (!strncmp(s, "AUTH ", 5)) {
    cmd_auth(s + 5);
  } else if (!strncmp(s, "SIGN ", 5)) {
    cmd_sign(s + 5);
  } else if (*s) {
    Serial.println(F("ERR unknown command (PING, INFO, AUTH, SIGN)"));
  }
}

void setup() {
  Serial.begin(115200);
#if USE_TAP_BUTTON
  pinMode(TAP_PIN, INPUT_PULLUP);
  pinMode(LED_BUILTIN, OUTPUT);
#endif
  // A different key id means a freshly provisioned key: start its counter at 0.
  bool fresh = false;
  for (uint8_t i = 0; i < 4; i++)
    if (EEPROM.read(EE_MAGIC + i) != pgm_read_byte(BK_KEY_ID + i)) fresh = true;
  if (fresh) {
    for (uint8_t i = 0; i < 4; i++) EEPROM.update(EE_MAGIC + i, pgm_read_byte(BK_KEY_ID + i));
    set_fails(0);
  }
  last_attempt = millis();   // a reboot starts the cooldown over, it doesn't skip it
  Serial.print(F("READY kagi-nano v1 id="));
  print_hex(BK_KEY_ID, 12, true);
  Serial.println();
}

void loop() {
  while (Serial.available()) {
    char ch = Serial.read();
    if (ch == '\n' || ch == '\r') {
      if (line_overflow) {
        Serial.println(F("ERR line too long"));
      } else if (line_len) {
        line[line_len] = 0;
        handle_line(line);
      }
      line_len = 0;
      line_overflow = false;
    } else if (line_len < MAX_LINE) {
      line[line_len++] = ch;
    } else {
      line_overflow = true;
    }
  }
}
