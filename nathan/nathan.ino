// Each commitment above is 32 bytes of salt followed by the 32-byte PBKDF2 output.

// ---------- LOCKOUT ----------
// Failed guesses are counted in EEPROM. The first FREE_TRIES are instant;
// after that each attempt must wait 15 s, 30 s, 60 s, ... (max ~64 min) since
// the previous attempt or since power-up. A correct level-2 query (which needs
// the PIN) resets the counter; other successes simply don't count as failures.
#define FREE_TRIES 5
#define EE_MAGIC 0     // 4 bytes: start of the key id, so a new key resets the counter
#define EE_FAILS 4

// ---------- TAP BUTTON ----------
// "Tap your key": wire a push button between D2 and GND and set USE_TAP_BUTTON
// to 1. SIGN then waits (built-in LED blinking) until the button is pressed.
// With 0, SIGN answers at once and the phone app asks you to press Enter instead.
